#!/usr/bin/env bash
# Clipboard history picker via cliphist + rofi + wl-copy.
# Adapted from JaKooLit's Hyprland-Dots ClipManager.sh for this rice's theme.
#
# Ctrl+Delete = delete one entry, Alt+Delete = wipe all history.

rofi_theme="$HOME/.config/rofi/glass.rasi"
msg='Ctrl+Del: delete entry   |   Alt+Del: wipe all'

if pidof rofi > /dev/null; then
    pkill rofi
fi

while true; do
    result=$(
        rofi -i -dmenu \
            -kb-custom-1 "Control-Delete" \
            -kb-custom-2 "Alt-Delete" \
            -config "$rofi_theme" < <(cliphist list) \
            -mesg "$msg"
    )

    case "$?" in
        1)
            exit
            ;;
        0)
            case "$result" in
                "")
                    continue
                    ;;
                *)
                    cliphist decode <<< "$result" | wl-copy
                    exit
                    ;;
            esac
            ;;
        10)
            cliphist delete <<< "$result"
            ;;
        11)
            cliphist wipe
            ;;
    esac
done
