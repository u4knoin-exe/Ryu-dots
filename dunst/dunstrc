[global]
    monitor = 0
    follow = mouse

    width = 370
    height = (0, 300)
    origin = top-right
    offset = (14, 58)

    notification_limit = 5
    gap_size = 7

    padding = 13
    horizontal_padding = 15
    text_icon_padding = 10

    frame_width = 1
    frame_color = "#263039"
    separator_height = 0
    corner_radius = 13
    transparency = 7

    font = Iosevka Nerd Font 10
    line_height = 4
    format = "<b>%s</b>\n%b"
    markup = full
    alignment = left
    vertical_alignment = center

    icon_position = left
    min_icon_size = 32
    max_icon_size = 32

    show_indicators = no
    stack_duplicates = true
    hide_duplicate_count = true

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    idle_threshold = 120

[urgency_low]
    background = "#0d1014"
    foreground = "#aab4bf"
    frame_color = "#202830"
    timeout = 4

[urgency_normal]
    background = "#0d1014"
    foreground = "#eef2f5"
    frame_color = "#2b353e"
    timeout = 6

[urgency_critical]
    background = "#171014"
    foreground = "#ffffff"
    frame_color = "#874652"
    timeout = 0
