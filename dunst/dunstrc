[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 300)
    origin = top-right
    offset = (14, 48)

    notification_limit = 5
    gap_size = 8

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 10

    frame_width = 1
    frame_color = "#303038"
    separator_height = 0
    corner_radius = 14
    transparency = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 4

    format = "<b>%s</b>\n%b"
    markup = full
    alignment = left
    vertical_alignment = center

    icon_position = left
    min_icon_size = 32
    max_icon_size = 32

    show_indicators = no
    stack_duplicates = true
    hide_duplicate_count = true

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    idle_threshold = 120

[urgency_low]
    background = "#111114"
    foreground = "#b8b8c2"
    frame_color = "#2a2a30"
    timeout = 4

[urgency_normal]
    background = "#111114"
    foreground = "#eeeeee"
    frame_color = "#3a3a42"
    timeout = 6

[urgency_critical]
    background = "#181114"
    foreground = "#ffffff"
    frame_color = "#8f4650"
    timeout = 0
