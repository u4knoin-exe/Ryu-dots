#!/usr/bin/env bash
# ryu-layout [dwindle|scrolling]: switch tiling layout. No argument opens a menu.
F="$HOME/.config/hypr/look.lua"
choice="${1:-$(printf 'dwindle\nscrolling\n' | rofi -dmenu -i -no-custom -theme "$HOME/.config/rofi/power.rasi" -p layout)}"
case "$choice" in dwindle|scrolling) ;; *) exit 0 ;; esac
sed -i --follow-symlinks -E "s/^(    layout *= *\")[a-z]+(\")/\1${choice}\2/" "$F"
hyprctl reload >/dev/null 2>&1
notify-send "layout" "$choice" 2>/dev/null
exit 0
