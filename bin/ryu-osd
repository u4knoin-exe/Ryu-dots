#!/usr/bin/env bash
# ryu-osd <vol|mic|bright> <up|down|mute>: change the value and show a square popup (via dunst).
tag="string:x-dunst-stack-tag:ryu-osd"
show() { notify-send -h "$tag" -h "int:value:$2" "$1" "$3"; }

case "${1:-}" in
  vol)
    case "${2:-}" in
      up)   wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
      down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
      mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    esac
    out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
    v="$(awk '{printf "%d", $2*100 + 0.5}' <<<"$out")"
    if grep -q MUTED <<<"$out"; then show "volume" 0 "muted"; else show "volume" "$v" "${v}%"; fi ;;
  mic)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then show "microphone" 0 "muted"; else show "microphone" 100 "on"; fi ;;
  bright)
    case "${2:-}" in
      up)   brightnessctl -q set 5%+ ;;
      down) brightnessctl -q set 5%- ;;
    esac
    v="$(brightnessctl -m | cut -d, -f4 | tr -d '%')"
    show "brightness" "$v" "${v}%" ;;
esac
exit 0
