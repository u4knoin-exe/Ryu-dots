#!/usr/bin/env bash
# ryu-session: started once by Hyprland. Wallpaper and bar first, extras 2 seconds later,
# so the desktop appears sooner and nothing competes for CPU during login.
BIN="$HOME/.local/bin"

if command -v awww-daemon >/dev/null 2>&1; then
  setsid awww-daemon >/dev/null 2>&1 &
  for _ in $(seq 1 30); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
fi
"$BIN/ryu-wall" --restore >/dev/null 2>&1 &
setsid waybar >/dev/null 2>&1 &
setsid dunst >/dev/null 2>&1 &

(
  sleep 2
  systemctl --user start hyprpolkitagent 2>/dev/null
  setsid hypridle >/dev/null 2>&1 &
  setsid hyprsunset >/dev/null 2>&1 &
  setsid wl-paste --watch cliphist store >/dev/null 2>&1 &
) &
exit 0
