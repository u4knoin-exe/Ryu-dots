#!/usr/bin/env bash
# ryu-ws-events: watches Hyprland and keeps the workspace state for the Waybar buttons up to date.
# Writes $XDG_RUNTIME_DIR/ryu-ws.state and nudges Waybar (signal 8) only when something changed.
STATE="${XDG_RUNTIME_DIR:-/tmp}/ryu-ws.state"
SOCK="${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"

update() {
  local active occupied new
  active="$(hyprctl activeworkspace 2>/dev/null | awk '/^workspace ID/ {print $3; exit}')"
  occupied="$(hyprctl workspaces 2>/dev/null | awk '/^workspace ID/ {id=$3} /windows:/ { if ($2 > 0) printf "%s ", id }')"
  new="active=${active:-1}
occupied=${occupied}"
  if [ "$new" != "$(cat "$STATE" 2>/dev/null)" ]; then
    printf '%s\n' "$new" > "$STATE"
    pkill -RTMIN+8 -x waybar 2>/dev/null
  fi
}

update
command -v socat >/dev/null 2>&1 || { echo "ryu-ws-events: install socat" >&2; exit 1; }
while true; do
  socat -U - "UNIX-CONNECT:$SOCK" 2>/dev/null | while read -r line; do
    case "$line" in
      workspace*|createworkspace*|destroyworkspace*|openwindow*|closewindow*|movewindow*|moveworkspace*|focusedmon*) update ;;
    esac
  done
  sleep 1   # reconnect if the socket dropped
done
