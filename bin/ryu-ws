#!/usr/bin/env bash
# ryu-ws <n>: JSON for Waybar's workspace button n (class: active / occupied / empty). Cheap: reads a state file.
n="${1:?usage: ryu-ws <n>}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/ryu-ws.state"
active=1; occupied=""
if [ -f "$STATE" ]; then
  active="$(sed -n 's/^active=//p' "$STATE")"
  occupied="$(sed -n 's/^occupied=//p' "$STATE")"
fi
class="empty"
case " $occupied " in *" $n "*) class="occupied" ;; esac
[ "$n" = "$active" ] && class="active"
printf '{"text":"%s","class":"%s"}\n' "$n" "$class"
