configuration {
    font: "Iosevka Nerd Font 14";
    show-icons: false;
    disable-history: true;
}

* {
    background-color: transparent;
    text-color: #eeeeee;
}

window {
    width: 390px;
    background-color: rgba(10, 10, 13, 0.96);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    padding: 24px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.055);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 15px;
    padding: 13px 16px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: rgba(139, 233, 253, 0.9);
}

entry {
    background-color: transparent;
    text-color: #ffffff;
    placeholder: "Power options...";
    placeholder-color: rgba(255, 255, 255, 0.3);
}

listview {
    background-color: transparent;
    lines: 5;
    spacing: 6px;
    scrollbar: false;
}

element {
    background-color: transparent;
    border-radius: 14px;
    padding: 14px 16px;
}

element selected {
    background-color: rgba(255, 255, 255, 0.09);
    border: 1px;
    border-color: rgba(139, 233, 253, 0.16);
}

element-text {
    background-color: transparent;
    text-color: #eeeeee;
}
