configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    font: "Iosevka Nerd Font 13";
    display-drun: "Apps";
    disable-history: true;
}

* {
    background-color: transparent;
    text-color: #e9edf2;
}

window {
    width: 650px;
    background-color: rgba(9, 11, 14, 0.94);
    border: 1px;
    border-color: rgba(255,255,255,0.10);
    border-radius: 18px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba(255,255,255,0.055);
    border: 1px;
    border-color: rgba(255,255,255,0.075);
    border-radius: 12px;
    padding: 11px 14px;
}

prompt {
    background-color: transparent;
    text-color: rgba(139,233,253,0.9);
    padding: 0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color: #ffffff;
    placeholder: "Search applications";
    placeholder-color: rgba(255,255,255,0.28);
}

listview {
    background-color: transparent;
    lines: 7;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: true;
}

element {
    background-color: transparent;
    border-radius: 10px;
    padding: 9px 11px;
}

element selected {
    background-color: rgba(139,233,253,0.09);
    border: 1px;
    border-color: rgba(139,233,253,0.13);
}

element-icon {
    background-color: transparent;
    size: 30px;
    margin: 0 12px 0 0;
}

element-text {
    background-color: transparent;
    text-color: #e9edf2;
    vertical-align: 0.5;
}
