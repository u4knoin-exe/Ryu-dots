{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "CachyOS",
        "padding": {
            "top": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },

        "separator",

        {
            "type": "os",
            "key": "  OS"
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime"
        },
        {
            "type": "wm",
            "key": "  WM"
        },
        {
            "type": "terminal",
            "key": "  Terminal"
        },
        {
            "type": "terminalfont",
            "key": "󰛖  Font"
        },

        "separator",

        {
            "type": "cpu",
            "key": "  CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU"
        },
        {
            "type": "memory",
            "key": "󰍛  Memory"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk"
        },
        {
            "type": "battery",
            "key": "󰁹  Battery"
        },

        "break",

        "colors"
    ]
}
