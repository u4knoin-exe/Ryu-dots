# Ryu-dots lazygit (generated from theme/palette.env)
gui:
  nerdFontsVersion: "3"
  border: single
  theme:
    activeBorderColor:
      - "#{{accent}}"
      - bold
    inactiveBorderColor:
      - "#{{muted}}"
    searchingActiveBorderColor:
      - "#{{yellow}}"
      - bold
    optionsTextColor:
      - "#{{muted}}"
    selectedLineBgColor:
      - "#{{overlay}}"
    inactiveViewSelectedLineBgColor:
      - "#{{surface}}"
    cherryPickedCommitFgColor:
      - "#{{accent2}}"
    cherryPickedCommitBgColor:
      - "#{{overlay}}"
    unstagedChangesColor:
      - "#{{red}}"
    defaultFgColor:
      - "#{{fg}}"
