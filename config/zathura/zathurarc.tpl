# Ryu-dots zathura (generated from theme/palette.env)
set font "{{font}} 11"
set default-bg "#{{bg}}"
set default-fg "#{{fg}}"
set statusbar-bg "#{{surface}}"
set statusbar-fg "#{{fg}}"
set inputbar-bg "#{{surface}}"
set inputbar-fg "#{{fg}}"
set notification-bg "#{{surface}}"
set notification-fg "#{{fg}}"
set notification-error-bg "#{{surface}}"
set notification-error-fg "#{{red}}"
set notification-warning-bg "#{{surface}}"
set notification-warning-fg "#{{yellow}}"
set completion-bg "#{{surface}}"
set completion-fg "#{{fg}}"
set completion-highlight-bg "#{{accent}}"
set completion-highlight-fg "#{{bg}}"
set highlight-color "#{{accent_dim}}"
set highlight-active-color "#{{accent}}"
set recolor "true"
set recolor-lightcolor "#{{bg}}"
set recolor-darkcolor "#{{fg}}"
set recolor-keephue "false"
set selection-clipboard clipboard
set guioptions "s"
