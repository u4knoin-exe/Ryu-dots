/* Ryu-dots GTK3 overrides (Adwaita named colors) */
@define-color theme_bg_color #{{bg}};
@define-color theme_fg_color #{{fg}};
@define-color theme_base_color #{{bg}};
@define-color theme_text_color #{{fg}};
@define-color theme_selected_bg_color #{{accent}};
@define-color theme_selected_fg_color #{{bg}};
@define-color insensitive_bg_color #{{surface}};
@define-color insensitive_fg_color #{{muted}};
@define-color borders #{{overlay}};
@define-color theme_unfocused_bg_color #{{bg}};
@define-color theme_unfocused_base_color #{{bg}};
@define-color theme_unfocused_fg_color #{{muted}};
@define-color theme_unfocused_text_color #{{muted}};
@define-color theme_unfocused_selected_bg_color #{{accent_dim}};
@define-color theme_unfocused_selected_fg_color #{{bg}};

* { border-radius: 0; }
headerbar, .titlebar { background: #{{surface}}; box-shadow: none; }
