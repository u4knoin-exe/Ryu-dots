# Ryu-dots cava (generated from theme/palette.env)
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[color]
background = default
foreground = '#{{accent}}'
gradient = 1
gradient_color_1 = '#{{muted}}'
gradient_color_2 = '#{{accent_dim}}'
gradient_color_3 = '#{{accent}}'
gradient_color_4 = '#{{accent2}}'

[smoothing]
noise_reduction = 77
