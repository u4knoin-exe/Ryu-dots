font_family      {{kitty_font}}
font_size        {{font_size}}
window_padding_width 10
confirm_os_window_close 0
enable_audio_bell no
cursor_shape beam

# Glass: Hyprland does the blur, kitty only provides alpha.
# Keep these AFTER any include line, themes can override them.
background_opacity 0.62
dynamic_background_opacity yes

foreground #{{fg}}
background #{{bg}}
selection_foreground #{{bg}}
selection_background #{{accent}}
cursor #{{accent2}}
url_color #{{accent2}}
color0  #{{overlay}}
color8  #{{muted}}
color1  #{{red}}
color9  #{{red}}
color2  #{{green}}
color10 #{{green}}
color3  #{{yellow}}
color11 #{{yellow}}
color4  #{{blue}}
color12 #{{blue}}
color5  #{{accent}}
color13 #{{accent2}}
color6  #{{cyan}}
color14 #{{cyan}}
color7  #{{fg}}
color15 #{{fg}}
