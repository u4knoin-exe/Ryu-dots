{
    "layer": "top",
    "position": "top",
    "passthrough": false,
    "height": 42,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock",
        "custom/music"
    ],

    "modules-right": [
        "tray",
        "custom/volume",
        "network",
        "battery"
    ],

    "custom/arch": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "all-outputs": false,
        "show-special": false,
        "disable-scroll": false,
        "persistent-workspaces": {
            "*": 9
        },
        "format-icons": {
            "active": "●",
            "default": "○",
            "urgent": "◆"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<b>{:%A}</b>\n{:%d %B %Y}",
        "interval": 1
    },

    "custom/music": {
        "format": "󰎆  {}",
        "exec": "playerctl metadata --format '{{ artist }}  ·  {{ title }}' 2>/dev/null || true",
        "interval": 2,
        "max-length": 34,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 7
    },

    "custom/volume": {
        "format": "{}",
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{if ($3==\"[MUTED]\") print \"󰖁  MUTED\"; else printf \"󰕾  %d%%\\n\", $2*100}'",
        "interval": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  offline",
        "format-disabled": "󰤭  disabled",
        "tooltip-format": "{ifname}\n{ipaddr}",
        "max-length": 20
    },

    "battery": {
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄  {capacity}%",
        "format-warning": "󰂃  {capacity}%",
        "format-critical": "󰂃  {capacity}%",
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "{capacity}%  ·  {time}"
    }
}
