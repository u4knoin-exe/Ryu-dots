configuration {
    modi: "drun";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
}
* { background-color: transparent; text-color: #eaeaea; }
window {
    width: 620px;
    background-color: rgba(8, 8, 10, 0.94);
    border: 1px; border-color: rgba(230, 69, 90, 0.4);
    border-radius: 10px; padding: 22px;
}
mainbox { background-color: transparent; children: [ inputbar, listview ]; spacing: 16px; }
inputbar {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px; border-color: rgba(230, 69, 90, 0.25);
    border-radius: 8px; children: [ prompt, entry ]; padding: 12px 16px;
}
prompt { background-color: transparent; text-color: rgba(230, 69, 90, 0.7); }
entry { background-color: transparent; text-color: #ffffff; placeholder: "Search applications..."; placeholder-color: rgba(255, 255, 255, 0.3); }
listview { background-color: transparent; lines: 6; spacing: 6px; scrollbar: false; }
element { background-color: transparent; border-radius: 8px; padding: 10px; }
element selected { background-color: rgba(230, 69, 90, 0.18); border: 1px; border-color: rgba(230, 69, 90, 0.4); }
element-text { background-color: transparent; text-color: #eaeaea; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 32px; margin: 0 12px 0 0; }
