[general]
bars = 6
framerate = 30
autosens = 1
sensitivity = 100

[input]
method = pipewire

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7

[color]
gradient = 0
foreground = default
background = default

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 0.77
