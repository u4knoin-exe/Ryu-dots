#!/usr/bin/env bash
VOL=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2*100}')
CHOICE=$(printf '%s\n' "󰕾   Volume: ${VOL}%" "󰝟   Mute / Unmute" "󰕾   Volume +5%" "󰕾   Volume -5%" | rofi -dmenu -i -p "󰕾  AUDIO" -theme "$HOME/.config/rofi/power.rasi")
case "$CHOICE" in
    *"Mute"*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *"+5%"*) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    *"-5%"*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
esac
