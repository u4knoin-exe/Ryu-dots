#!/usr/bin/env bash
cava -p "$HOME/.config/cava/waybar" 2>/dev/null | while IFS= read -r line; do
    line="${line// /}"
    [ -n "$line" ] || continue
    text=$(printf '%s' "$line" | sed 's/0/▁/g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g;s/8/█/g')
    printf '{"text":"%s","class":"visualizer"}\n' "$text" || break
done
